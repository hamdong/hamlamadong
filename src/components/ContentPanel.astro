---
const { title } = Astro.props;
---

<section class="overflow-hidden rounded-2xl border border-white/10 bg-slate-950/30 shadow-xl shadow-slate-950/10 backdrop-blur-xl">
  <div class="border-b border-white/10 px-5 py-4">
    <span class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-slate-400">
      {title}
    </span>
  </div>
  <div class="space-y-4 p-5">
    <slot />
  </div>
</section>
