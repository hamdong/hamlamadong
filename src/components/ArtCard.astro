---
import type { ContentCardModel } from '../lib/content';

interface Props {
  model: ContentCardModel;
}

const { model } = Astro.props;
---

<a
  href={model.href}
  aria-label={`View artwork: ${model.title}`}
  class="group block overflow-hidden rounded-2xl border border-white/10 bg-slate-950/30 shadow-xl shadow-slate-950/10 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-cyan-200/40 hover:bg-slate-900/35 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-200"
>
  {model.image && (
    <div class="aspect-[4/3] overflow-hidden bg-slate-950/40">
      <img
        src={model.image}
        alt={model.title}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      />
    </div>
  )}
</a>
