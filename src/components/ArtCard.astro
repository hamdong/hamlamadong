---
import type { ContentCardModel } from '../lib/content';
import { formatDate } from '../lib/date';

interface Props {
  model: ContentCardModel;
}

const { model } = Astro.props;
const formattedDate = formatDate(model.date);
---

<a
  href={model.href}
  aria-label={`View artwork: ${model.title}`}
  class="group block overflow-hidden rounded-2xl border border-white/10 bg-slate-950/30 shadow-xl shadow-slate-950/10 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-cyan-200/40 hover:bg-slate-900/35 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-200"
>
  {model.image && (
    <div class="aspect-[4/3] overflow-hidden bg-slate-950/40">
      <img
        src={model.image}
        alt={model.title}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      />
    </div>
  )}
  <div class="flex items-baseline justify-between gap-3 border-t border-white/10 px-4 py-3">
    <h3 class="truncate text-sm font-semibold text-white transition-colors group-hover:text-sky-200">
      {model.title}
    </h3>
    <time class="shrink-0 font-mono text-[0.68rem] text-slate-400">{formattedDate}</time>
  </div>
</a>
