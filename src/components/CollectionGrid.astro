---
import { getCollection } from 'astro:content';
import ContentCard from './ContentCard.astro';
import ArtCard from './ArtCard.astro';
import {
  getContentCardModel,
  collectionDescriptors,
  isPublished,
  type SiteCollection,
} from '../lib/content';

interface Props {
  title: string;
  collectionName: SiteCollection;
}

const { title, collectionName } = Astro.props;

const posts = (await getCollection(collectionName))
  .filter((p) => isPublished(p, import.meta.env.PROD))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const Card = collectionDescriptors[collectionName].cardVariant === 'art'
  ? ArtCard
  : ContentCard;
---

<div class="w-full">
  <header class="mb-7 flex items-end justify-between border-b border-white/10 pb-4 sm:mb-8 sm:pb-4">
    <h2 class="text-[clamp(1.375rem,2.8vw,1.875rem)] font-semibold tracking-tight text-white">{title}</h2>
  </header>

  <div class="grid grid-cols-1 items-start gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3 lg:gap-6">
    {
      posts.map((post) => (
        <Card model={getContentCardModel(post, collectionName)} />
      ))
    }
  </div>

  {
    !posts.length && (
      <p class="font-mono text-sm text-slate-300">
        No {collectionName} entries detected.
      </p>
    )
  }
</div>
