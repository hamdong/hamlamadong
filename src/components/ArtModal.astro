---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/date';

interface Props {
  entry: CollectionEntry<'art'>;
  prevEntry?: CollectionEntry<'art'> | null;
  nextEntry?: CollectionEntry<'art'> | null;
}

const { entry, prevEntry, nextEntry } = Astro.props;

const formattedDate = formatDate(entry.data.date);
---

<div
  id="art-modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-label={`Artwork viewer: ${entry.data.title}`}
  tabindex="-1"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 lg:p-8 bg-slate-950/85 backdrop-blur-md overflow-y-auto"
>
  <!-- Close Button (Routes back to main grid) -->
  <a
    id="art-modal-close"
    href="/art"
    class="fixed top-5 right-5 z-50 p-3 rounded-full bg-slate-900/80 border border-white/10 text-slate-300 hover:text-white hover:bg-slate-800 transition-all shadow-lg"
    aria-label="Close modal"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </a>

  <!-- Prev Arrow -->
  {
    prevEntry && (
      <a
        href={`/art/${prevEntry.slug}`}
        id="prev-btn"
        class="fixed left-4 top-1/2 -translate-y-1/2 z-50 p-3 rounded-full bg-slate-900/80 border border-white/10 text-slate-300 hover:text-white hover:scale-110 transition-all shadow-xl hidden sm:flex"
        aria-label="Previous Artwork"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"
          />
        </svg>
      </a>
    )
  }

  <!-- Next Arrow -->
  {
    nextEntry && (
      <a
        href={`/art/${nextEntry.slug}`}
        id="next-btn"
        class="fixed right-4 top-1/2 -translate-y-1/2 z-50 p-3 rounded-full bg-slate-900/80 border border-white/10 text-slate-300 hover:text-white hover:scale-110 transition-all shadow-xl hidden sm:flex"
        aria-label="Next Artwork"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          />
        </svg>
      </a>
    )
  }

  <!-- Modal Card -->
  <div
    id="art-modal-card"
    class="relative w-full max-w-5xl my-auto flex flex-col items-center"
  >
    <!-- Enlarged Artwork Image -->
    <div
      class="relative max-h-[70vh] sm:max-h-[75vh] flex justify-center items-center overflow-hidden rounded-2xl border border-white/15 bg-slate-900/50 shadow-2xl"
    >
      <img
        src={entry.data.image}
        alt={entry.data.title}
        class="max-h-[70vh] sm:max-h-[75vh] w-auto max-w-full object-contain select-none"
      />
    </div>
    <div class="mt-3 flex max-w-2xl items-baseline justify-center gap-3 px-3 text-center">
      <h1 class="truncate text-base font-semibold text-white sm:text-lg">
        {entry.data.title}
      </h1>
      <time class="shrink-0 font-mono text-[0.68rem] uppercase tracking-widest text-slate-400">
        {formattedDate}
      </time>
    </div>

    <!-- Mobile Navigation Controls -->
    <div class="flex items-center justify-center gap-6 sm:hidden">
      {
        prevEntry && (
          <a
            href={`/art/${prevEntry.slug}`}
            class="font-mono text-xs text-sky-400"
            aria-label="Previous artwork"
          >
            ← Previous
          </a>
        )
      }
      <a href="/art" class="font-mono text-xs uppercase text-slate-400">Index</a>
      {
        nextEntry && (
          <a
            href={`/art/${nextEntry.slug}`}
            class="font-mono text-xs text-sky-400"
            aria-label="Next artwork"
          >
            Next →
          </a>
        )
      }
    </div>
  </div>
</div>

<script>
  let cleanup = () => {};

  function initializeModal() {
    cleanup();

    const backdrop = document.getElementById('art-modal-backdrop');
    const card = document.getElementById('art-modal-card');
    if (!backdrop || !card) return;
    const previouslyFocused = document.activeElement as HTMLElement | null;

    const closeLink = backdrop.querySelector<HTMLAnchorElement>(
      'a[href="/art"]',
    );
    const onClick = (event: Event) => {
      const target = event.target;
      if (target === backdrop) {
        closeLink?.click();
      }
    };
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') closeLink?.click();
      if (event.key === 'ArrowLeft' && document.getElementById('prev-btn')) {
        document.getElementById('prev-btn')?.click();
      }
      if (event.key === 'ArrowRight' && document.getElementById('next-btn')) {
        document.getElementById('next-btn')?.click();
      }
    };

    backdrop.addEventListener('click', onClick);
    document.addEventListener('keydown', onKeyDown);
    cleanup = () => {
      backdrop.removeEventListener('click', onClick);
      document.removeEventListener('keydown', onKeyDown);
      document.body.style.overflow = '';
      previouslyFocused?.focus();
    };
    backdrop.focus();
    document.body.style.overflow = 'hidden';
  }

  document.addEventListener('astro:page-load', initializeModal);
  document.addEventListener('astro:before-preparation', () => cleanup());
  initializeModal();
</script>
