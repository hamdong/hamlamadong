---
import type { ContentCardModel } from '../lib/content';

interface Props {
  model: ContentCardModel;
}

const { model } = Astro.props;
const tag = model.tags[0];
---

<a href={model.href} class="group glass-card flex h-full flex-col">
  <div class="flex flex-1 flex-col gap-4 p-5">
    <div class="flex items-center justify-between gap-3">
      <span
        class="text-lg font-semibold text-white transition-colors group-hover:text-sky-200"
      >
        {model.title}
      </span>
      <time class="whitespace-nowrap font-mono text-xs text-slate-200">
        {model.date.toLocaleDateString('en-US', {
          month: 'numeric',
          day: 'numeric',
          year: 'numeric',
        }).replace(/\//g, '.')}
      </time>
    </div>

    {
      model.image ? (
        <div class="h-20 w-full shrink-0 overflow-hidden rounded border border-white/10 bg-slate-950/50">
          <img
            src={model.image}
            alt={model.title}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </div>
      ) : (
        model.description && (
          <p class="line-clamp-3 text-sm leading-relaxed text-slate-300">
            {model.description}
          </p>
        )
      )
    }

    {
      tag && (
        <div class="mt-auto inline-flex self-start items-center gap-2 rounded-full border border-slate-200/10 bg-white/5 px-3 py-1 text-xs uppercase tracking-widest text-slate-300">
          <span class="text-sky-200">#{tag}</span>
        </div>
      )
    }
  </div>
</a>
