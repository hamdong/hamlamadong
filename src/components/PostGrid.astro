---
import { getCollection } from 'astro:content';
import TagFilter from './TagFilter.astro';
import PostCard from './PostCard.astro';
import ArtCard from './ArtCard.astro';
import {
  getContentCardModel,
  collectionDescriptors,
  isPublished,
  type SiteCollection,
} from '../lib/content';

interface Props {
  title: string;
  collectionName: SiteCollection;
}

const { title, collectionName } = Astro.props;

const posts = (await getCollection(collectionName))
  .filter((p) => isPublished(p, import.meta.env.PROD))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [
  ...new Set(
    posts.flatMap((p) => getContentCardModel(p, collectionName).tags),
  ),
].sort();

const Card = collectionDescriptors[collectionName].cardVariant === 'art'
  ? ArtCard
  : PostCard;
---

<div class="w-full">
  <header class="mb-8 flex items-end justify-between border-b border-white/10 pb-4">
    <h2>{title}</h2>
  </header>

  {allTags.length > 0 && <TagFilter tags={allTags} />}

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
    {
      posts.map((post) => (
        <Card model={getContentCardModel(post, collectionName)} />
      ))
    }
  </div>

  {
    !posts.length && (
      <p class="font-mono text-sm text-slate-300">
        No {collectionName} entries detected.
      </p>
    )
  }
</div>

<style>
  .post-item.hidden {
    display: none;
  }
</style>
