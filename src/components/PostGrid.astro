---
import { getCollection, type CollectionKey } from 'astro:content';
import TagFilter from './TagFilter.astro';
import PostCard from './PostCard.astro';
import ArtCard from './ArtCard.astro';
import {
  getContentCardModel,
  isPublished,
  isSiteCollection,
  type SiteCollection,
} from '../lib/content';

interface Props {
  title: string;
  collectionName: SiteCollection;
}

const { title, collectionName } = Astro.props;

const posts = (await getCollection(collectionName))
  .filter((p) => isSiteCollection(p.collection))
  .filter((p) => isPublished(p, import.meta.env.PROD))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [
  ...new Set(
    posts.flatMap((p) => getContentCardModel(p, collectionName).tags),
  ),
].sort();

const Card = collectionName === 'art' ? ArtCard : PostCard;
---

<div class="w-full">
  <header class="mb-6 border-b border-white/10 pb-2">
    <h2 class="text-2xl font-bold text-white">{title}</h2>
  </header>

  {allTags.length > 0 && <TagFilter tags={allTags} />}

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
    {
      posts.map((post) => (
        <Card model={getContentCardModel(post, collectionName)} />
      ))
    }
  </div>

  {
    !posts.length && (
      <p class="font-mono text-sm text-slate-300">
        No {collectionName} entries detected.
      </p>
    )
  }
</div>

<style>
  .post-item.hidden {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll(
      '.filter-btn',
    ) as NodeListOf<HTMLButtonElement>;
    const postItems = document.querySelectorAll(
      '.post-item',
    ) as NodeListOf<HTMLAnchorElement>;

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const selectedFilter = button.dataset.filter ?? '';
        filterButtons.forEach((btn) => btn.classList.remove('active'));
        button.classList.add('active');

        postItems.forEach((post) => {
          if (selectedFilter === 'all') {
            post.classList.remove('hidden');
          } else {
            const postTags = (post.dataset.tags ?? '')
              .split(',')
              .filter(Boolean);
            post.classList.toggle('hidden', !postTags.includes(selectedFilter));
          }
        });
      });
    });
  });
</script>
