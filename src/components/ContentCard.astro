---
import type { ContentCardModel } from '../lib/content';
import { formatDate } from '../lib/date';

interface Props {
  model: ContentCardModel;
}

const { model } = Astro.props;
---

<a
  href={model.href}
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-slate-950/30 shadow-xl shadow-slate-950/10 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-cyan-200/40 hover:bg-slate-900/35 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-200"
>
  <div
    class="aspect-[16/10] overflow-hidden border-b border-white/10 bg-slate-950/40"
  >
    {
      model.image && (
        <img
          src={model.image}
          alt={model.title}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-4 p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <time class="font-mono text-xs font-semibold text-slate-200">
        {formatDate(model.date)}
      </time>

      {
        model.statusLabel && (
          <span class="animate-pulse font-mono text-xs uppercase tracking-wide text-sky-200">
            {model.statusLabel}
          </span>
        )
      }
    </div>

    <h3
      class="text-lg font-semibold leading-tight text-slate-100 transition-colors group-hover:text-sky-200"
    >
      {model.title}
    </h3>

    <div class="mt-1 flex items-center justify-between gap-3">
      <span class="font-mono text-xs uppercase tracking-widest text-slate-400">
        {model.actionLabel}
      </span>

      {
        typeof model.rating === 'number' && (
          <span class="font-mono text-sm tracking-wide text-yellow-400">
            {'★'.repeat(model.rating)}
            {'☆'.repeat(5 - model.rating)}
          </span>
        )
      }
    </div>

  </div>
</a>
