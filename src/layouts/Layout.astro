---
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import WaterSurface from '../components/WaterSurface.astro';
import '../styles/global.css';

const { title = 'Hamlamadong' } = Astro.props;
const navLinks = [
  { href: '/', label: 'HOME' },
  { href: '/blog', label: 'BLOG' },
  { href: '/art', label: 'ART' },
  { href: '/games', label: 'GAMES' },
  { href: '/reading', label: 'READING' },
  { href: '/about', label: 'ABOUT' },
];

const navClass =
  'inline-flex min-h-10 items-center font-pixel text-base text-sky-200 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-200 sm:text-lg';

const isActiveRoute = (href: string) =>
  href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href);
---

<html lang="en" class="scroll-smooth overflow-y-scroll">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono&family=VT323&family=Inter:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-[#0b5f8d] bg-[radial-gradient(circle_at_50%_-10%,rgba(186,230,253,0.34),transparent_36%),linear-gradient(180deg,#083b66_0%,#0b5f8d_48%,#126e87_100%)] bg-fixed font-sans text-slate-50"
  >
    <div class="min-h-screen">
      <header class="sticky top-0 z-30 border-b border-white/10 bg-[#07385f]/90 py-3 backdrop-blur-xl sm:py-5">
        <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-3 sm:gap-6 sm:px-6 lg:px-8">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-xl font-bold tracking-[0.1em] text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-200 sm:gap-3 sm:text-2xl sm:tracking-[0.18em] lg:text-3xl"
            aria-label="Hamlamadong home"
          >
            <span
              class="h-3 w-3 rounded-full bg-cyan-300 shadow-[0_0_18px_rgba(103,232,249,0.9)] sm:h-4 sm:w-4"
              aria-hidden="true"
            ></span>
            <span>HAMLAMADONG</span>
          </a>
          <nav
            aria-label="Primary navigation"
            class="flex flex-wrap items-center gap-x-3 gap-y-1.5 sm:gap-x-5 sm:gap-y-2"
          >
            {navLinks.map((link) => (
              <a
                href={link.href}
                class={`${navClass} ${isActiveRoute(link.href) ? 'text-white' : ''}`}
                aria-current={isActiveRoute(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))}
          </nav>
        </div>
      </header>

      <main class="mx-auto w-full max-w-6xl px-3 py-7 sm:px-6 sm:py-10 lg:px-8 lg:py-14">
        <WaterSurface>
          <slot />
        </WaterSurface>
      </main>

      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
        <Footer />
      </div>
    </div>
  </body>
</html>
