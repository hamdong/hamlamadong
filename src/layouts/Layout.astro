---
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import WaterSurface from '../components/WaterSurface.astro';
import '../styles/global.css';

const { title = 'Hamlamadong' } = Astro.props;
const navLinks = [
  { href: '/', label: 'HOME' },
  { href: '/blog', label: 'BLOG' },
  { href: '/art', label: 'ART' },
  { href: '/games', label: 'GAMES' },
  { href: '/reading', label: 'READING' },
  { href: '/about', label: 'ABOUT' },
];

const navClass =
  'font-pixel text-base text-sky-200 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-200 sm:text-lg';
---

<html lang="en" class="scroll-smooth overflow-y-scroll">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono&family=VT323&family=Inter:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-[#0b5f8d] bg-[radial-gradient(circle_at_50%_-10%,rgba(186,230,253,0.34),transparent_36%),linear-gradient(180deg,#083b66_0%,#0b5f8d_48%,#126e87_100%)] bg-fixed font-sans text-slate-50"
  >
    <div class="min-h-screen">
      <header class="sticky top-0 z-30 border-b border-white/10 bg-[#07385f]/90 py-5 backdrop-blur-xl sm:py-6">
        <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
          <a
            href="/"
            class="inline-flex items-center gap-3 text-2xl font-bold tracking-[0.18em] text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-200 sm:text-3xl"
            aria-label="Hamlamadong home"
          >
            <span
              class="h-4 w-4 rounded-full bg-cyan-300 shadow-[0_0_18px_rgba(103,232,249,0.9)]"
              aria-hidden="true"
            ></span>
            <span>HAMLAMADONG</span>
          </a>
          <nav
            aria-label="Primary navigation"
            class="flex flex-wrap items-center gap-x-5 gap-y-2"
          >
            {navLinks.map((link) => (
              <a href={link.href} class={navClass}>{link.label}</a>
            ))}
          </nav>
        </div>
      </header>

      <main class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
        <WaterSurface>
          <slot />
        </WaterSurface>
      </main>

      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
        <Footer />
      </div>
    </div>
  </body>
</html>
