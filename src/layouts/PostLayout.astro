---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import PostMedia from '../components/PostMedia.astro';
import PostMetadata from '../components/PostMetadata.astro';
import {
  getContentDetailModel,
  type SiteCollection,
  type SiteEntry,
} from '../lib/content';

interface Props {
  entry: Exclude<SiteEntry, CollectionEntry<'art'>>;
  collectionName: Exclude<SiteCollection, 'art'>;
}

const { entry, collectionName } = Astro.props;
const detail = getContentDetailModel(entry, collectionName);
---

<Layout title={entry.data.title}>
  <article class="w-full">
    {detail.heroImage && <PostMedia src={entry.data.image} alt={entry.data.title} placement="hero" />}

    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
      <PostMetadata model={detail} date={entry.data.date}>
        <h1
          slot="title"
          class="mb-4 text-3xl font-semibold leading-tight tracking-tight text-white sm:text-5xl"
        >
          {entry.data.title}
        </h1>
      </PostMetadata>

      <div class="glass-panel overflow-hidden">
        {detail.bodyImage && <PostMedia src={entry.data.image} alt={entry.data.title} placement="body" />}

        <slot />
      </div>

      <footer class="mt-16 pt-10 border-t border-white/10">
        <a
          href={`/${collectionName}`}
          class="font-mono text-xs font-semibold text-slate-300 hover:text-white transition-colors uppercase tracking-widest"
        >
          ← Return to {
            collectionName.charAt(0).toUpperCase() + collectionName.slice(1)
          } Index
        </a>
      </footer>
    </div>
  </article>
</Layout>
