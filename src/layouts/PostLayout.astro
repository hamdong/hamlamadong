---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import PostMedia from '../components/PostMedia.astro';
import PostMetadata from '../components/PostMetadata.astro';
import {
  getContentDetailModel,
  type StandardCollection,
} from '../lib/content';

interface Props {
  entry: CollectionEntry<StandardCollection>;
  collectionName: StandardCollection;
}

const { entry, collectionName } = Astro.props;
const detail = getContentDetailModel(entry, collectionName);
---

<Layout title={entry.data.title}>
  <article class="w-full">
    {detail.heroImage && <PostMedia src={entry.data.image} alt={entry.data.title} placement="hero" />}

    <div class="mx-auto max-w-6xl px-1 py-6 sm:px-6 sm:py-10">
      <PostMetadata model={detail} date={entry.data.date}>
        <h1
          slot="title"
          class="mb-4 text-[clamp(1.75rem,4vw,3rem)] font-semibold leading-tight tracking-tight text-white"
        >
          {entry.data.title}
        </h1>
      </PostMetadata>

      <nav class="mb-8" aria-label={`Return to ${collectionName} collection`}>
        <a
          href={`/${collectionName}`}
          class="font-mono text-xs font-semibold uppercase tracking-widest text-slate-300 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-200"
        >
          ← Return to {
            collectionName.charAt(0).toUpperCase() + collectionName.slice(1)
          } Index
        </a>
      </nav>

      <div
        class="mx-auto max-w-[70ch] text-base leading-7 text-slate-100 sm:px-1 sm:text-lg sm:leading-8 [&_a]:text-cyan-200 [&_a]:underline [&_a]:decoration-cyan-200/50 [&_a]:underline-offset-4 [&_a]:hover:text-white [&_blockquote]:my-6 [&_blockquote]:border-l-4 [&_blockquote]:border-cyan-200/60 [&_blockquote]:pl-4 [&_blockquote]:italic sm:[&_blockquote]:my-8 sm:[&_blockquote]:pl-5 [&_code]:rounded [&_code]:bg-slate-950/40 [&_code]:px-1.5 [&_code]:py-0.5 [&_h2]:mb-4 [&_h2]:mt-10 [&_h2]:text-[1.375rem] [&_h2]:font-semibold [&_h2]:leading-tight [&_h2]:text-white sm:[&_h2]:mb-4 sm:[&_h2]:mt-12 sm:[&_h2]:text-2xl [&_h3]:mb-3 [&_h3]:mt-7 [&_h3]:text-[1.1875rem] [&_h3]:font-semibold [&_h3]:leading-tight [&_h3]:text-white sm:[&_h3]:mb-3 sm:[&_h3]:mt-8 sm:[&_h3]:text-xl [&_li]:my-1 [&_ol]:my-4 [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:my-5 [&_ul]:my-5 [&_ul]:list-disc [&_ul]:pl-5 sm:[&_li]:my-2 sm:[&_ol]:my-6 sm:[&_ol]:pl-6 sm:[&_p]:my-6 sm:[&_ul]:my-6 sm:[&_ul]:pl-6"
      >
        {detail.bodyImage && <PostMedia src={entry.data.image} alt={entry.data.title} placement="body" />}

        <slot />
      </div>

    </div>
  </article>
</Layout>
