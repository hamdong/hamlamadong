---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SidebarBox from '../components/SidebarBox.astro';
import LatestCard from '../components/LatestCard.astro';
import {
  getContentCardModel,
  isPublished,
  sortByDate,
} from '../lib/content';

const [blogPosts, artPosts, readingPosts, gamesPosts] = await Promise.all([
  getCollection('blog'),
  getCollection('art'),
  getCollection('reading'),
  getCollection('games'),
]);

const latestPosts = sortByDate(
  [...blogPosts, ...artPosts, ...readingPosts, ...gamesPosts].filter((entry) =>
    isPublished(entry, import.meta.env.PROD),
  ),
)
  .slice(0, 5);
---

<Layout>
  <!-- Welcome Section -->
  <section class="content-panel mb-12 p-6 sm:p-8">
    <div class="space-y-4">
      <h2>Welcome</h2>
      <p>
        Welcome to my personal website! This place is meant to serve as a secret
        getaway for myself, separate from other ongoing projects that may have
        more, um... corporate incentive for existing.
      </p>
      <p>
        This project was half an experiment and half of something that I've been
        wanting to make for a long time. If you're curious about the tech, it
        was made with a combination of <a
          href="https://astro.build/"
          target="_blank"
          rel="noreferrer"
          class="text-sky-200 hover:text-sky-100 transition-colors">Astro</a
        > and this open-source CMS called <a
          href="https://github.com/sveltia/sveltia-cms"
          target="_blank"
          rel="noreferrer"
          class="text-sky-200 hover:text-sky-100 transition-colors">Sveltia</a
        >.
      </p>
    </div>
  </section>

  <!-- Latest Posts Section -->
  <section class="mb-12">
    <div
      class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <h2>Latest Posts</h2>
      </div>
    </div>

    <div class="mt-6 grid gap-5 md:grid-cols-2">
      {
        latestPosts.map((post) => (
          <LatestCard model={getContentCardModel(post, post.collection)} />
        ))
      }
    </div>
  </section>

  <!-- Misc Section -->
  <SidebarBox title="OTHER STUFF">
    <div class="space-y-4">
      <div>
        <p class="text-xs uppercase tracking-widest text-slate-400 mb-1">
          STATUS
        </p>
        <p class="text-sm">Under active development</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-slate-400 mb-1">
          INTERESTS
        </p>
        <p class="text-sm">Web design, creative coding, music</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-slate-400 mb-1">
          CURRENTLY
        </p>
        <p class="text-sm">Rebuilding & redesigning this space</p>
      </div>
    </div>
  </SidebarBox>
</Layout>
