---
import PostLayout from '../../layouts/PostLayout.astro';
import { getSiteCollectionPaths } from '../../lib/content';

export async function getStaticPaths() {
  return getSiteCollectionPaths('blog');
}
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<PostLayout entry={entry} collectionName="blog">
  <Content />
</PostLayout>
