---
import Layout from '../../layouts/Layout.astro';
import ContentPanel from '../../components/ContentPanel.astro';
---

<Layout title="About Me">
  <h2 class="mb-8 text-2xl font-semibold tracking-tight text-white sm:text-3xl">About Me</h2>

  <div class="space-y-8">
    <!-- Profile -->
    <div>
      <h3 class="mb-4 text-lg font-semibold tracking-tight text-white sm:text-xl">Profile</h3>
      <ContentPanel title="INFO">
        <div class="space-y-2">
          <p>
            <span class="font-mono text-slate-400">Location:</span> Canada
          </p>
          <p>
            <span class="font-mono text-slate-400">Favourite Artist:</span> Rush
          </p>
          <p>
            <span class="font-mono text-slate-400">Primary Tech:</span> Astro
          </p>
          <p>
            <span class="font-mono text-slate-400">Current Status:</span> Exploring
          </p>
        </div>
      </ContentPanel>
    </div>

    <!-- Interests -->
    <div>
      <h3 class="mb-4 text-lg font-semibold tracking-tight text-white sm:text-xl">Interests</h3>
      <p class="text-white/80">Web design, coding, art, reading, and music</p>
    </div>

    <!-- What I'm Working On -->
    <div>
      <h3 class="mb-4 text-lg font-semibold tracking-tight text-white sm:text-xl">Currently</h3>
      <p class="text-white/80">
        I'm working on this website and trying to get all my thoughts down.
        Thought it would be a cool way to share this with the world while also
        laying low.
      </p>
    </div>
  </div>
</Layout>
